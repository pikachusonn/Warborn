[ext_resource type="Script" uid="uid://bdh8l77oovwaa" path="res://resources/skills/Quagmire/Quagmire/quagmire.gd" id="1_1w01o"]

[resource]
script = ExtResource("1_1w01o")
description = "Consume a pillar to create a 3x3 mud zone for 3 caster turns. Enemies take 10 damage when their turn starts inside. Units inside have at most 1 mobility and cannot use mobility skills. Overlaps replace only covered tiles. Costs 1 energy."
action_cost = 1
cooldown = 2
metadata/_custom_type_script = "uid://bdh8l77oovwaa"
