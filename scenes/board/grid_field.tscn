[sub_resource type="Shader" id="Shader_background_lighting"]
code = "shader_type canvas_item;\n\nuniform vec2 light_center = vec2(0.5, 0.48565);\nuniform vec2 light_scale = vec2(1.15, 1.0);\nuniform float inner_radius : hint_range(0.0, 1.0) = 0.20;\nuniform float mid_radius : hint_range(0.0, 1.0) = 0.44;\nuniform float outer_radius : hint_range(0.0, 1.5) = 0.72;\nuniform float mid_darkness : hint_range(0.0, 1.0) = 0.25;\nuniform float edge_darkness : hint_range(0.0, 1.0) = 1.0;\nuniform vec4 veil_color : source_color = vec4(0.035, 0.043, 0.065, 1.0);\n\nuniform vec2 top_fade_range = vec2(0.015, 0.08);\nuniform vec2 bottom_fade_range = vec2(0.92, 0.985);\nuniform vec2 left_fade_range = vec2(0.015, 0.06);\nuniform vec2 right_fade_range = vec2(0.94, 0.985);\n\nvoid fragment() {\n\tvec2 offset = (UV - light_center) * light_scale;\n\tfloat dist = length(offset);\n\tfloat inner_v = smoothstep(inner_radius, mid_radius, dist) * mid_darkness;\n\tfloat outer_b = smoothstep(mid_radius * 0.9, outer_radius, dist) * (edge_darkness - mid_darkness);\n\tfloat radial = clamp(inner_v + outer_b, 0.0, edge_darkness);\n\n\tfloat fade_t = 1.0 - smoothstep(top_fade_range.x, top_fade_range.y, UV.y);\n\tfloat fade_b = smoothstep(bottom_fade_range.x, bottom_fade_range.y, UV.y);\n\tfloat fade_l = 1.0 - smoothstep(left_fade_range.x, left_fade_range.y, UV.x);\n\tfloat fade_r = smoothstep(right_fade_range.x, right_fade_range.y, UV.x);\n\tfloat edge_fade = max(max(fade_t, fade_b), max(fade_l, fade_r));\n\n\tfloat alpha = clamp(max(radial, edge_fade), 0.0, 1.0);\n\tCOLOR = vec4(veil_color.rgb, alpha * veil_color.a);\n}\n"

